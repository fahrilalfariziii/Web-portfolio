# Client (public, tidak sensitif)
VITE_GA_ID=G-XXXXXXXXXX

# Server-only (JANGAN pakai VITE_ agar tidak ter-bundle ke frontend)
# Set di Vercel Dashboard > Settings > Environment Variables (Production & Preview)
# dan di .env lokal untuk `npm run dev` / `npm run seed`
SUPABASE_URL=https://xyz.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
# Batasi login admin ke email tertentu (comma-separated). Kosongkan = semua authenticated bisa (tidak disarankan)
ADMIN_EMAILS=

# Legacy support (jika masih pakai VITE_ di server, diisi sama dengan di atas)
# VITE_SUPABASE_URL=https://xyz.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
